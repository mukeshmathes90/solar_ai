# Copy this file to ".env" and adjust if needed.  Every value is optional:
# the defaults below are what the application uses when nothing is set.
#
# These are read by config/settings.py at import time.  On Windows, either set
# them as real environment variables or load the file yourself before starting
# the server (run.bat does not read .env automatically).

# --- Server ----------------------------------------------------------------
# 0.0.0.0 listens on every interface, which the ESP8266 needs in order to POST
# to the laptop over the phone hotspot. Use 127.0.0.1 to keep it local only.
MICROGRID_HOST=0.0.0.0
MICROGRID_PORT=5000
MICROGRID_DEBUG=0
MICROGRID_SECRET=change-me-for-anything-beyond-a-local-demo

# --- Storage ---------------------------------------------------------------
# Point these at a different location if you want the database or dataset
# somewhere other than data/db/ and data/dataset/.
#MICROGRID_DB=data/db/microgrid.db
#MICROGRID_DATASET=data/dataset/microgrid_dataset.csv
